'use client'
import { useState, useEffect } from 'react'
import { supabaseBrowser } from '@/lib/supabase'
import { useToast } from '@/components/ui/Toaster'

export default function TeamPage() {
  const toast = useToast()
  const [admins, setAdmins] = useState<any[]>([])
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [adding, setAdding] = useState(false)

  async function loadAdmins() {
    const res = await fetch('/api/admin/list-admins')
    if (res.ok) {
      const data = await res.json()
      setAdmins(data.admins || [])
    }
  }

  useEffect(() => { loadAdmins() }, [])

  async function handleAddAdmin(e: React.FormEvent) {
    e.preventDefault()
    setAdding(true)
    try {
      const res = await fetch('/api/admin/create-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      })
      const data = await res.json()
      if (!res.ok) {
        toast.error(data.error || 'Failed to create user')
        return
      }
      toast.success(`Admin account created for ${email}`)
      setEmail('')
      setPassword('')
      loadAdmins()
    } catch (err: any) {
      toast.error(err.message)
    } finally {
      setAdding(false)
    }
  }

  async function handleRemoveAdmin(userId: string) {
    if (!confirm('Remove this admin?')) return
    const res = await fetch('/api/admin/remove-admin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId }),
    })
    if (res.ok) {
      toast.success('Admin removed')
      loadAdmins()
    } else {
      toast.error('Failed to remove')
    }
  }

  async function handleChangePassword(e: React.FormEvent) {
    e.preventDefault()
    const { error } = await supabaseBrowser.auth.updateUser({ password })
    if (error) { toast.error(error.message); return }
    toast.success('Password updated!')
    setPassword('')
  }

  return (
    <div className="p-6 lg:p-8 max-w-2xl">
      <h1 className="text-2xl font-extrabold text-dark mb-8">Team & Access</h1>

      <div className="bg-white border border-border rounded-xl p-6 mb-6">
        <h2 className="font-bold text-dark mb-4 border-b border-border pb-3">Current Admins</h2>
        {admins.map(admin => (
          <div key={admin.id} className="flex items-center justify-between py-3 border-b border-border last:border-0">
            <div>
              <p className="text-sm font-semibold text-dark">{admin.email}</p>
              <p className="text-xs text-muted">Admin</p>
            </div>
            <button onClick={() => handleRemoveAdmin(admin.user_id)} className="text-xs text-danger hover:underline">
              Remove
            </button>
          </div>
        ))}
        {admins.length === 0 && <p className="text-sm text-muted">No admins found.</p>}
      </div>

      <div className="bg-white border border-border rounded-xl p-6 mb-6">
        <h2 className="font-bold text-dark mb-4">Change My Password</h2>
        <form onSubmit={handleChangePassword} className="space-y-4">
          <input
            type="password"
            value={password}
            onChange={e => setPassword(e.target.value)}
            required
            minLength={8}
            className="w-full border border-border rounded-lg px-3 py-2.5 text-sm"
            placeholder="New password (min 8 chars)"
          />
          <button type="submit" className="h-10 px-6 bg-dark text-white text-sm rounded-full">
            Update Password
          </button>
        </form>
      </div>

      <div className="bg-white border border-border rounded-xl p-6">
        <h2 className="font-bold text-dark mb-1">Add New Admin</h2>
        <p className="text-xs text-muted mb-4">This person will have full access to the admin panel.</p>
        <form onSubmit={handleAddAdmin} className="space-y-4">
          <input
            type="email"
            value={email}
            onChange={e => setEmail(e.target.value)}
            required
            className="w-full border border-border rounded-lg px-3 py-2.5 text-sm"
            placeholder="newadmin@example.com"
          />
          <input
            type="password"
            value={password}
            onChange={e => setPassword(e.target.value)}
            required
            minLength={8}
            className="w-full border border-border rounded-lg px-3 py-2.5 text-sm"
            placeholder="Password (min 8 chars)"
          />
          <button type="submit" disabled={adding}
            className="h-10 px-6 bg-primary text-white text-sm rounded-full disabled:opacity-60"
          >
            {adding ? 'Creating...' : 'Create Admin Account'}
          </button>
        </form>
      </div>
    </div>
  )
}