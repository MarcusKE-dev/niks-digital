# ════════════════════════════════════════════════════════
# NIKS DIGITAL CONNECTION — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ════════════════════════════════════════════════════════

# ── SUPABASE ─────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — ONLY used server-side (API routes, admin).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ── DARAJA / M-PESA ──────────────────────────────────────
# Get these from: developer.safaricom.co.ke → My Apps

DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret

# Your M-Pesa Paybill or Till number
DARAJA_SHORTCODE=174379

# Lipa Na M-Pesa Online passkey (from Safaricom portal)
DARAJA_PASSKEY=your-daraja-passkey

# The full URL Safaricom will POST payment results to.
# In development, use ngrok: https://xxxx.ngrok.io/api/mpesa/callback
# In production: https://niksdigital.co.ke/api/mpesa/callback
DARAJA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# Sandbox or production: 'sandbox' | 'production'
DARAJA_ENVIRONMENT=sandbox


# ── FLUTTERWAVE (Card Payments) ───────────────────────────
# Get these from: dashboard.flutterwave.com → Settings → API

NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key


# ── CLOUDINARY (Image Storage) ───────────────────────────
# Get these from: console.cloudinary.com → Dashboard

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Upload preset for unsigned uploads (create in Cloudinary settings)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=niks-digital-products


# ── SITE CONFIG ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://niksdigital.co.ke
NEXT_PUBLIC_SITE_NAME=Niks Digital Connection
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000001

# ── ADMIN ────────────────────────────────────────────────
# Email address that gets admin access via Supabase Auth.
# After first deploy, sign up with this email on the site
# and then set it as admin in Supabase → Authentication → Users.
ADMIN_EMAIL=admin@niksdigital.co.ke
